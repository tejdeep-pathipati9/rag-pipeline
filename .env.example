EMBEDDING_REVISION=c9745ed1d9f207416be6d2e6f8de32d1f16199bf
MODEL_CACHE_DIR=.cache/models

# Reserved for answer generation; not used by ingestion.
LLM_API_KEY=
LLM_MODEL=
