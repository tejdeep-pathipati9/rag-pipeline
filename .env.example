# Copy to .env and fill these locally. Never commit .env or paste keys into chat.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=flight-disruption
# Smoke commands only accept namespaces beginning with smoke-.
PINECONE_NAMESPACE=smoke-flight-disruption
# Only used when smoke-pinecone is invoked with --create-index.
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Public model commit; fixed so repeat runs use the same weights.
EMBEDDING_REVISION=c9745ed1d9f207416be6d2e6f8de32d1f16199bf
MODEL_CACHE_DIR=.cache/models

# Reserved for Phase 3. Not needed for validate-corpus or smoke-pinecone.
LLM_API_KEY=
LLM_MODEL=
